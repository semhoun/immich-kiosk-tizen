# syntax=docker/dockerfile:1.7
ARG TIZEN_SDK_IMAGE=immich-kiosk-tizen-sdk:local
FROM ${TIZEN_SDK_IMAGE}
USER root
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      xvfb xauth x11-utils x11vnc fluxbox novnc websockify tini \
      dbus-x11 xdg-utils locales fonts-dejavu fonts-liberation \
      libgtk-3-0 libgtk2.0-0 libwebkit2gtk-4.0-37 libnss3 libasound2 \
      libxtst6 libxi6 libxrender1 libgbm1 openssl \
    && locale-gen en_US.UTF-8 fr_FR.UTF-8 \
    && rm -rf /var/lib/apt/lists/*
# Required by the current official Certificate-Manager dependency checks.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libkf5itemmodels5 libkf5kiowidgets5 libkchart2 \
    && rm -rf /var/lib/apt/lists/*
ARG TIZEN_ACCEPT_LICENSE=no
USER sdk
RUN test "$TIZEN_ACCEPT_LICENSE" = yes \
    && timeout 900 /opt/tizen-studio/package-manager/package-manager-cli.bin install --accept-license Certificate-Manager,cert-add-on \
    && test -x /opt/tizen-studio/tools/certificate-manager/certificate-manager
USER root
COPY tools/certificate-ui.sh /usr/local/bin/certificate-ui
RUN chmod 755 /usr/local/bin/certificate-ui
ENV HOME=/signing LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 \
    DISPLAY=:0 XAUTHORITY=/signing/.Xauthority \
    XDG_CONFIG_HOME=/signing/.config XDG_CACHE_HOME=/signing/.cache \
    XDG_DATA_HOME=/signing/.local/share XDG_RUNTIME_DIR=/signing/.runtime \
    SWT_GTK3=1 WEBKIT_DISABLE_COMPOSITING_MODE=1
WORKDIR /signing
EXPOSE 6080
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/bin/certificate-ui"]
CMD []
